    Vector Positions have to be Int! No Floats!

    List of Days:
    1: Sunday
    2: Monday
    3: Tuesday
    4: Wednesday
    5: Thursday
    6: Friday
    7: Saturday

    Example Config
    <WorldBoss ID="MI_AIBATT1" Aggro="1" World="WI_WORLD_MADRIGAL">
        <Vector x="1" y="1" z="1"/>
        <Spawns>
            <Spawn Day="1" Time="18:00:00"/>
            <Spawn Day="7" Time="18:00:00"/>
        </Spawns>
        <LootTable>
            <Loot ID="II_WEA_SWO_WOODEN" Count="1" Bind="false"/>
        </LootTable>
    </WorldBoss>

-->
