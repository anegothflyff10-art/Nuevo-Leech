// 	Monster Hunt Quests
//	MonsterHunt questID <<<<<<<<<<<no duplicates<<<<<<<<<<<<
//	{
//		mobID			<< id from propmover
//		mobNum 			<< amount of mobs needed to finish the quest
//		activeHunt 		<< 1=quest enabled /  0=quest disabled     >>>(dont delete quests! will mess with DB saving)<<<
