//	}
//
//		Regions ALL=0 / Flaris=1 / Saint Morning=2 / Garden of Rhisis=3 / Darkon 1/2=4 / Darkon 3=5 / Shaduwar=6 / Valley of the Risen=7 / Eillun=8 / Bahara Desert=9 / Coral Island=10 / 
// 		Azria=11 / Traseia=12 / Dark Traseia=13 / Forteress=14 / Volcano=15 / Tower=16 / Other=17
//
//

